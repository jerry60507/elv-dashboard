  const totVeh = s1Curr.reduce((a, b) => a + b.tot_veh, 0);
  const baseVeh = s1Base.reduce((a, b) => a + b.tot_veh, 0);
  const vehDiffPct = baseVeh > 0 ? ((totVeh - baseVeh) / baseVeh * 100) : 0;
  const carPct = totVeh > 0 ? (s1Curr.reduce((a, b) => a + b.car_tot, 0) / totVeh * 100) : 0;

  const shipTons = s1Curr.reduce((a, b) => a + b.ship_wt_kg, 0) / 1000;

  const s2CurrAll = s2Data.filter(d => d.plant === '4家合計' && d.year === targetYear && targetMonths.includes(d.month));
  const certInAllTons = s2CurrAll.reduce((a, b) => a + b.in_cert, 0) / 1000;

  const s2CurrPlant = s2Data.filter(d => d.plant === plant && d.year === targetYear && targetMonths.includes(d.month));
