  // --- 6. CHART E & TABLE F: 4 PLANTS COMPARISON ---
  const plantStats = PLANTS.map(pName => {
    const rows = s2Data.filter(d => d.plant === pName && d.year === targetYear && targetMonths.includes(d.month));
    const latest = rows[rows.length - 1] || { inv_shell: 0, inv_asr: 0, inv_asrdf: 0, asrdf_prod: 1 };
    const cert = rows.reduce((a,b)=>a+b.in_cert,0)/1000;
