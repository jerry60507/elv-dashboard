      </tr>
    </tbody>
  `;
  document.getElementById('auditTable').innerHTML = tbodyHtml;
}

function selectPlant(pName) {
  document.getElementById('plantSelect').value = pName;
  renderDashboard();
}

function updateChart(id, config) {
  if (charts[id]) {
    charts[id].destroy();
  }
  const ctx = document.getElementById(id).getContext('2d');
  charts[id] = new Chart(ctx, config);
}

// Excel File Upload Parser (Allows instant refresh when user updates Excel!)
document.getElementById('excelInput').addEventListener('change', function(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(evt) {
    try {
      const data = new Uint8Array(evt.target.result);
      const wb = XLSX.read(data, { type: 'array' });

      // Parse Sheet 1: 廢車回收業
      const ws1 = wb.Sheets['廢車回收業'];
      const rows1 = XLSX.utils.sheet_to_json(ws1, { header: 1 });
      const newS1 = [];
      for (let r = 0; r < rows1.length; r++) {
        const ym = String(rows1[r][0] || '').trim();
        if (/^(114|115|116)-\d{2}$/.test(ym)) {
          const totVeh = Number(rows1[r][12]) || 0;
          if (totVeh > 0) {
            newS1.push({
              ym,
              year: ym.slice(0, 3),
              month: parseInt(ym.slice(4, 6), 10),
              car_cert: Number(rows1[r][1]) || 0,
              car_exp: Number(rows1[r][2]) || 0,
              car_oth: Number(rows1[r][3]) || 0,
              car_tot: Number(rows1[r][4]) || 0,
              moto_cert: Number(rows1[r][5]) || 0,
              moto_exp: Number(rows1[r][6]) || 0,
              moto_oth: Number(rows1[r][7]) || 0,
              moto_tot: Number(rows1[r][8]) || 0,
              tot_cert: Number(rows1[r][9]) || 0,
              tot_exp: Number(rows1[r][10]) || 0,
              tot_oth: Number(rows1[r][11]) || 0,
              tot_veh: totVeh,
              est_wt_kg: Number(rows1[r][13]) || 0,
              ship_wt_kg: Number(rows1[r][14]) || 0
            });
          }
        }
      }

      // Parse Sheet 2: 廢車處理業
      const ws2 = wb.Sheets['廢車處理業'];
      const rows2 = XLSX.utils.sheet_to_json(ws2, { header: 1 });
      const newS2 = [];
      let currentPlant = '4家合計';
      for (let r = 0; r < rows2.length; r++) {
        const col0 = String(rows2[r][0] || '').trim();
        if (col0 && ['4家合計', '帝壹統', '集合成', '綠化', '巨基'].includes(col0)) {
          currentPlant = col0;
        }
        const ym = String(rows2[r][1] || '').trim();
        if (/^(114|115|116)-\d{2}$/.test(ym)) {
          const inTot = Number(rows2[r][4]) || 0;
          if (inTot > 0) {
            newS2.push({
              plant: currentPlant,
              ym,
              year: ym.slice(0, 3),
              month: parseInt(ym.slice(4, 6), 10),
              in_cert: Number(rows2[r][2]) || 0,
              in_noncert: Number(rows2[r][3]) || 0,
              in_tot: inTot,
              proc_wt: Number(rows2[r][5]) || 0,
              inv_shell: Number(rows2[r][6]) || 0,
              asr_prod: Number(rows2[r][7]) || 0,
              asrdf_prod: Number(rows2[r][8]) || 0,
              asr_ship: Number(rows2[r][9]) || 0,
              asrdf_ship: Number(rows2[r][10]) || 0,
              inv_asr: Number(rows2[r][11]) || 0,
              inv_asrdf: Number(rows2[r][12]) || 0
            });
          }
        }
      }

      if (newS1.length > 0 && newS2.length > 0) {
        s1Data = newS1.sort((a,b) => a.ym.localeCompare(b.ym));
        s2Data = newS2;
        const latestYm = s1Data[s1Data.length - 1].ym;
        document.getElementById('dataStatusText').textContent = `已匯入《${file.name}》最新數據（截至 ${latestYm}）｜ 圖表已即時同步更新`;
        initMonthSelector();
        renderDashboard();
        alert(`匯入成功！已自動更新至最新月份：${latestYm}`);
      } else {
        alert('無法讀取有效數據，請確認檔案包含「廢車回收業」與「廢車處理業」兩個工作表且格式未變動。');
      }
    } catch (err) {
      alert('讀取 Excel 發生錯誤：' + err.message);
    }
  };
  reader.readAsArrayBuffer(file);
});

